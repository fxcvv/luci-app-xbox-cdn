#!/bin/sh
# Xbox CDN 优化 - 后台启动与状态查询
# 由 luci-app-xbox-cdn 调用

STATUS_FILE="/tmp/xbox-cdn-status.json"
LOG_FILE="/tmp/xbox-speedtest.log"
SCRIPT="/usr/bin/xbox-speedtest.sh"
UCI_MODE=$(uci -q get xbox-cdn.settings.mode 2>/dev/null)
[ -z "$UCI_MODE" ] && UCI_MODE="dnsmasq"

case "$1" in
    start)
        # 已在运行则直接返回
        if [ -f "$STATUS_FILE" ] && grep -q '"state": "running"' "$STATUS_FILE" 2>/dev/null; then
            echo '{"state":"running","msg":"already running"}'
            exit 0
        fi

        # 清空日志，用 start-stop-daemon 完全脱离后台运行（ubus file.exec 才能立即返回）
        : > "$LOG_FILE"
        start-stop-daemon -S -b -O "$LOG_FILE" -x /usr/bin/xbox-speedtest.sh -- --mode "$UCI_MODE" --apply
        echo '{"state":"started"}'
        ;;

    status)
        if [ -f "$STATUS_FILE" ]; then
            cat "$STATUS_FILE"
        else
            echo '{"state":"idle","last_run":"","mode":"'$UCI_MODE'"}'
        fi
        ;;

    log)
        if [ -f "$LOG_FILE" ]; then
            tail -n 100 "$LOG_FILE"
        fi
        ;;

    current-config)
        # 显示当前生效的规则
        case "$UCI_MODE" in
            smartdns)
                if [ -f /etc/smartdns/custom.conf ]; then
                    echo "=== SmartDNS custom.conf（xbox-cdn 块）==="
                    sed -n '/^# BEGIN xbox-cdn$/,/^# END xbox-cdn$/p' /etc/smartdns/custom.conf
                else
                    echo "尚未生成配置"
                fi
                ;;
            *)
                if [ -f /tmp/dnsmasq.d/xbox-cdn.conf ]; then
                    echo "=== dnsmasq 配置 ==="
                    cat /tmp/dnsmasq.d/xbox-cdn.conf
                else
                    echo "尚未生成配置"
                fi
                ;;
        esac
        ;;

    *)
        echo "用法: $0 {start|status|log|current-config}"
        exit 1
        ;;
esac
