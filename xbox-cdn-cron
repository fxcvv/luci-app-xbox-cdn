#!/bin/sh
# Xbox CDN 优化 - 定时任务管理
# 用法: xbox-cdn-cron enable <小时> <分钟> | disable | status

CRONTAB_FILE="/etc/crontabs/root"
CRON_TAG="# xbox-cdn-speedtest"

case "$1" in
    enable)
        HOUR="${2:-3}"
        MIN="${3:-0}"
        MODE=$(uci -q get xbox-cdn.settings.mode 2>/dev/null)
        [ -z "$MODE" ] && MODE="dnsmasq"

        # 删除已有的 xbox-cdn 条目
        if [ -f "$CRONTAB_FILE" ]; then
            sed -i "/$CRON_TAG/d" "$CRONTAB_FILE"
        fi

        # 添加新条目，通过 xbox-cdn-run 启动以便记录状态
        echo "$MIN $HOUR * * * /usr/bin/xbox-cdn-run start >/dev/null 2>&1 $CRON_TAG" >> "$CRONTAB_FILE"

        # 重载 cron
        /etc/init.d/cron restart >/dev/null 2>&1

        echo "已启用定时测速: 每天 ${HOUR}:$(printf '%02d' $MIN)"
        ;;

    disable)
        if [ -f "$CRONTAB_FILE" ]; then
            sed -i "/$CRON_TAG/d" "$CRONTAB_FILE"
        fi
        /etc/init.d/cron restart >/dev/null 2>&1
        echo "已停用定时测速"
        ;;

    status)
        if [ -f "$CRONTAB_FILE" ] && grep -q "$CRON_TAG" "$CRONTAB_FILE"; then
            grep "$CRON_TAG" "$CRONTAB_FILE"
        else
            echo "未启用"
        fi
        ;;

    *)
        echo "用法: $0 {enable <小时> <分钟>|disable|status}"
        exit 1
        ;;
esac
