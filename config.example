# Xbox CDN Speedtest Configuration Example
# Copy to /etc/xbox-speedtest.conf and customize

# ============= Paths =============
# Where to write dnsmasq configuration
DNSMASQ_CONF="/tmp/dnsmasq.d/xbox-cdn.conf"

# Log file location
LOG_FILE="/tmp/xbox-speedtest.log"

# CDN IP list
CDN_IP_FILE="/etc/xbox-cdn-ips.conf"

# Lock file to prevent concurrent runs
LOCK_FILE="/var/lock/xbox-speedtest.lock"

# ============= Test Parameters =============
# Download size per IP test (M = MB)
TEST_SIZE="10M"

# Number of concurrent downloads per test
CONCURRENT=3

# Timeout per test in seconds
TIMEOUT=15

# How many top IPs to keep per group
TOP_N=2

# ============= Test URLs =============
# Xbox CN CDN test path
XBOX_CN_URL="/filestable/"

# Akamai CDN test path
AKAMAI_URL="/filestable/"

# Microsoft Delivery CDN test path
MS_DELIVERY_URL="/"

# ============= Advanced =============
# Use local cache server (optional)
# Uncomment and set your cache server IP
# CACHE_SERVER="192.168.1.100"

# Custom dnsmasq restart command
# DNSMASQ_RESTART="/etc/init.d/dnsmasq restart"

# Enable debug output
# DEBUG=1
